  "transcript": {
    "cues": [
      {
        "id": "c1",
        "start": 0.3,
        "end": 6.48,
        "text": "Hello, everyone, and welcome to our Open Day at Riverside Community Centre."
      },
      {
        "id": "c2",
        "start": 6.83,
        "end": 12.77,
        "text": "I'm one of the volunteers, and I'm going to show you where three of our activity rooms are."
      },
      {
        "id": "c3",
        "start": 13.12,
        "end": 18.87,
        "text": "Have a look at the map. We're at the main entrance, right at the bottom, and north is at the top."
      },
      {
        "id": "c4",
        "start": 19.22,
        "end": 26.76,
        "text": "First, the Quiet Lounge. From the main entrance, go straight up the main hall to the noticeboard, and turn right."
      },
      {
        "id": "c5",
        "start": 27.11,
        "end": 34.76,
        "text": "You'll pass the meeting room on your right. The Quiet Lounge is at the far end of that corridor, also on your right."
      },
      {
        "id": "c6",
        "start": 35.11,
        "end": 40.6,
        "text": "Next, the Craft Room. Find the staff office, over on the west side of the map."
      },
      {
        "id": "c7",
        "start": 40.95,
        "end": 46.18,
        "text": "The Craft Room is directly north of the staff office, next door to it."
      },
      {
        "id": "c8",
        "start": 46.53,
        "end": 51.61,
        "text": "And finally, the table tennis room. For this one, start at the café."
      },
      {
        "id": "c9",
        "start": 51.96,
        "end": 60.51,
        "text": "The table tennis room is directly south of the café... oh, sorry, I mean north. It's just across the corridor from it."
      },
      {
        "id": "c10",
        "start": 60.86,
        "end": 67.42,
        "text": "So that's the Quiet Lounge, the Craft Room and the table tennis room. Enjoy the Open Day!"
      }
    ]
  },
