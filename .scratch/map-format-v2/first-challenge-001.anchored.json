  "transcript": {
    "cues": [
      {
        "id": "c1",
        "start": 0.3,
        "end": 5.06,
        "text": "Hello, and welcome to the Open Day at Riverside Community Centre."
      },
      {
        "id": "c2",
        "start": 5.75,
        "end": 11.95,
        "text": "We're standing at the main entrance, with north at the top of the map. I'll show you three rooms."
      },
      {
        "id": "c3",
        "start": 12.95,
        "end": 20.42,
        "text": "First, the Quiet Lounge. From the main entrance, go straight up the main hall to the noticeboard, and turn right."
      },
      {
        "id": "c4",
        "start": 21.11,
        "end": 28.64,
        "text": "You'll pass the meeting room on your right. The Quiet Lounge is at the far end of that corridor, also on your right."
      },
      {
        "id": "c5",
        "start": 29.64,
        "end": 37.48,
        "text": "Next, the Craft Room. Starting from the main entrance again, go up to the noticeboard, and turn left this time."
      },
      {
        "id": "c6",
        "start": 38.19,
        "end": 41.42,
        "text": "At the end of the corridor, turn right, and head north."
      },
      {
        "id": "c7",
        "start": 42.25,
        "end": 50.11,
        "text": "The first door on your left is the staff office. The Craft Room is the next door on your left, directly north of it."
      },
      {
        "id": "c8",
        "start": 51.11,
        "end": 60.55,
        "text": "And finally, the table tennis room. Start from the main entrance once more, turn left at the noticeboard, then right at the end, heading north."
      },
      {
        "id": "c9",
        "start": 61.37,
        "end": 65.12,
        "text": "Walk on past the café, on your right, to the end of the corridor."
      },
      {
        "id": "c10",
        "start": 65.79,
        "end": 72.95,
        "text": "The table tennis room is through the door on your left... no, sorry, my mistake — it's on your right."
      },
      {
        "id": "c11",
        "start": 73.58,
        "end": 76.08,
        "text": "You'll find it directly north of the café."
      },
      {
        "id": "c12",
        "start": 77.08,
        "end": 80.8,
        "text": "That's all three rooms. Enjoy the Open Day!"
      }
    ]
  },
