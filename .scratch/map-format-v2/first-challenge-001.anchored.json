  "transcript": {
    "cues": [
      {
        "id": "c1",
        "start": 0.3,
        "end": 6.4,
        "text": "Hello, everyone, and welcome to the Open Day at Riverside Community Centre."
      },
      {
        "id": "c2",
        "start": 6.75,
        "end": 9.98,
        "text": "Let me show you three of our activity rooms."
      },
      {
        "id": "c3",
        "start": 10.33,
        "end": 15.7,
        "text": "Have a look at the map. We're at the main entrance, at the bottom, and north is at the top."
      },
      {
        "id": "c4",
        "start": 16.05,
        "end": 23.59,
        "text": "First, the Quiet Lounge. From the main entrance, go straight up the main hall to the noticeboard, and turn right."
      },
      {
        "id": "c5",
        "start": 23.94,
        "end": 31.59,
        "text": "You'll pass the meeting room on your right. The Quiet Lounge is at the far end of that corridor, also on your right."
      },
      {
        "id": "c6",
        "start": 31.94,
        "end": 39.04,
        "text": "Next, the Craft Room. Starting from the main entrance again, go up to the noticeboard and turn left."
      },
      {
        "id": "c7",
        "start": 39.39,
        "end": 45.46,
        "text": "At the end, turn right and head north. The first door on your left is the staff office."
      },
      {
        "id": "c8",
        "start": 45.81,
        "end": 51.68,
        "text": "The Craft Room is the next door on your left, directly north of the staff office."
      },
      {
        "id": "c9",
        "start": 52.03,
        "end": 60.91,
        "text": "And finally, the table tennis room. Start from the main entrance once more, turn left at the noticeboard, and right at the end."
      },
      {
        "id": "c10",
        "start": 61.26,
        "end": 70.12,
        "text": "Walk north, past the café on your right. The table tennis room is directly south of the café... oh, sorry, I mean north."
      },
      {
        "id": "c11",
        "start": 70.47,
        "end": 72.83,
        "text": "You'll see its door on your right."
      },
      {
        "id": "c12",
        "start": 73.18,
        "end": 76.84,
        "text": "That's all three rooms. Enjoy the Open Day!"
      }
    ]
  },
