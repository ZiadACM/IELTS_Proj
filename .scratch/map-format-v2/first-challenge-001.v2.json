  "transcript": {
    "cues": [
      {
        "id": "c1",
        "start": 0.3,
        "end": 3.93,
        "text": "Hello, everyone, and welcome to our Open Day."
      },
      {
        "id": "c2",
        "start": 4.28,
        "end": 12.37,
        "text": "I'm one of the volunteers here at Riverside Community Centre, and I'm going to show you where a few of our activity rooms are."
      },
      {
        "id": "c3",
        "start": 12.72,
        "end": 18.19,
        "text": "OK, so right now we're standing at the main entrance, right at the bottom of the map."
      },
      {
        "id": "c4",
        "start": 18.54,
        "end": 22.71,
        "text": "If you look just to your right as you come in, that's reception."
      },
      {
        "id": "c5",
        "start": 23.06,
        "end": 26.63,
        "text": "And the toilets are opposite reception, on your left."
      },
      {
        "id": "c6",
        "start": 26.98,
        "end": 33.24,
        "text": "Now, straight ahead of you, down the main hall, there's a big noticeboard. That's where the hall splits."
      },
      {
        "id": "c7",
        "start": 33.59,
        "end": 38.02,
        "text": "Turn right at the noticeboard, and keep going along that corridor."
      },
      {
        "id": "c8",
        "start": 38.37,
        "end": 42.12,
        "text": "You'll pass the meeting room on your right, but don't stop there."
      },
      {
        "id": "c9",
        "start": 42.47,
        "end": 48.34,
        "text": "The Quiet Lounge is at the far end of that corridor, on your right, past the meeting room."
      },
      {
        "id": "c10",
        "start": 48.69,
        "end": 51.65,
        "text": "OK, let's go back to the noticeboard."
      },
      {
        "id": "c11",
        "start": 52,
        "end": 58.5,
        "text": "This time, turn left, walk to the end of that corridor, and then turn right, so you're heading north."
      },
      {
        "id": "c12",
        "start": 58.85,
        "end": 63.81,
        "text": "You'll see the staff office on your left. Just past it is the Craft Room."
      },
      {
        "id": "c13",
        "start": 64.16,
        "end": 67.49,
        "text": "Keep going north, past the corridor junction."
      },
      {
        "id": "c14",
        "start": 67.84,
        "end": 74.77,
        "text": "The table tennis room is on the west side... oh, sorry, I mean the east side, I always mix those two up."
      },
      {
        "id": "c15",
        "start": 75.12,
        "end": 82.31,
        "text": "So that's three rooms: the Quiet Lounge, the Craft Room and the table tennis room. Enjoy the Open Day!"
      }
    ]
  },
