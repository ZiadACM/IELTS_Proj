{
  "_comment": "Machine-readable authorization matrix. Source of truth; docs/security/authorization-matrix.md must match it (checked by tests/security/authorization-matrix.test.mjs). Status Proposed: NO API EXISTS YET. Owner decisions applied 2026-11-12 (docs/product/owner-decisions.md). Endpoints are a logical, stack-neutral inventory derived from the product blueprint; the owner and the first feature spec must confirm or change them. Paths use {param} placeholders.",
  "version": 1,
  "status": "proposed",
  "roles": {
    "anonymous": "No session. May only create a guest session, create an account, sign in or request a password reset.",
    "guest": "Server-issued guest session, no personal data (owner decision D5). Practises on its own data exactly like a learner; can upgrade to an account, keeping its data.",
    "learner": "A signed-in learner. Acts only on their own data.",
    "content_author": "Staff: drafts and imports items. Cannot publish. Also practises as a learner on their own data.",
    "content_reviewer": "Staff, a human: reviews and publishes items (CODING_STANDARDS 3.1). Also practises as a learner on their own data.",
    "admin": "Operator: manages staff roles only. No access to learners' or guests' attempts or progress (owner decision D7)."
  },
  "decisions": {
    "allow": "Permitted.",
    "deny": "Always refused. No session: 401. With a session: 403 or 404. The response body carries none of the resource's data.",
    "own": "Permitted only on the caller's own resource. Another user's resource: 404 (preferred, avoids enumeration) or 403, with no data.",
    "own-open": "As own, and only while the attempt is open: not submitted, and before the server-side deadline in exam mode.",
    "own-open-guided": "As own-open, and only in guided practice. Refused in exam simulation and independent check modes (CODING_STANDARDS 2.3).",
    "own-submitted": "As own, and only after the attempt is submitted (CODING_STANDARDS 2.2).",
    "published": "Permitted only for published items (validation.status = published). Draft or reviewed items: 404.",
    "draft-only": "Permitted only on items that are not published. Editing a published item is refused."
  },
