# Local development only (`npm start`). Matches compose.yaml: trust auth on 127.0.0.1, no password.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/masar
PORT=3000
# Low-entropy placeholder, refused when NODE_ENV=production (config.ts).
AUTH_SECRET=local-development-only-not-a-secret-0000
# Item audio for local development: the committed draft content (npm runs the server from server/).
CONTENT_DIR=../docs/content
