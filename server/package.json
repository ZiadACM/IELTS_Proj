{
  "name": "@masar/server",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --env-file=dev.env src/main.ts",
    "test": "node --env-file-if-exists=dev.env --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "invite-codes": "node --env-file-if-exists=dev.env src/access/invite-codes-cli.ts",
    "reset-links": "node --env-file-if-exists=dev.env src/access/reset-links-cli.ts",
    "staff-roles": "node --env-file-if-exists=dev.env src/staff/staff-roles-cli.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "better-auth": "1.7.15",
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1"
  }
}
